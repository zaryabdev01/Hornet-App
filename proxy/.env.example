# Copy to .env (gitignored) and fill in real values. Never commit the real .env.

PORT=8787

# Shared secret the mobile app sends as the X-App-Secret header. Generate a long random
# string (e.g. `openssl rand -hex 32`) — this is not the Gemini key, it just authorizes
# the app to use this proxy.
APP_SECRET=

# The real Gemini API key. Lives only here, server-side — never in the mobile app bundle.
GEMINI_API_KEY=

# M3 Phase 3 — must be an exact match for one of the strings in proxy/allowlist.js, and must
# match src/constants/branding.js's ENGINE.protocole on whichever app version is calling this
# proxy. The model itself is parsed out of this string (everything before the first "+") — do
# not set a separate model variable. The proxy refuses to start if this isn't allowlisted.
ACTIVE_BUNDLE=gemini-3.6-flash+prompt-V2.6+schema-V1.11
